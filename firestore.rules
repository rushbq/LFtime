rules_version = '2';

/**
 * 權限模型（簡化版）：
 * - View：任何人都能讀賽季、名單與聯盟主檔（前端只顯示我方踢除／候補）。
 * - Edit：持有聯盟邀請碼（呆萌小星／聰明的史努比，權限相同）的匿名身分，可編輯該聯盟所有賽季。
 * - 建立賽季：任何已匿名登入者（賽季管理頁以密碼防君子，不是真正的權限）。
 */
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function roles() {
      return ['xiaoxing', 'snoopy'];
    }

    function editorPath(allianceId) {
      return /databases/$(database)/documents/alliances/$(allianceId)/editors/$(request.auth.uid);
    }

    function validInvite(allianceId, role, inviteId) {
      let invite = get(/databases/$(database)/documents/allianceInvites/$(inviteId)).data;
      return invite.active == true
        && invite.allianceId == allianceId
        && invite.role == role;
    }

    // 編輯者：以有效邀請建立過自己的編輯身分；邀請停用後立即失效
    function isEditor(allianceId) {
      let editor = get(editorPath(allianceId)).data;
      return signedIn()
        && editor.allianceId == allianceId
        && validInvite(allianceId, editor.role, editor.inviteId);
    }

    function editorRole(allianceId) {
      return get(editorPath(allianceId)).data.role;
    }

    function eventPath(eventId) {
      return /databases/$(database)/documents/transferEvents/$(eventId);
    }

    function eventAlliance(eventId) {
      let event = get(eventPath(eventId)).data;
      return 'allianceId' in event ? event.allianceId : 'koi';
    }

    // 可寫入：活動開啟且未超過結束時間（closesAt 選填）；過了結束時間仍可讀取，只是變唯讀
    function eventIsWritable(eventId) {
      let event = get(eventPath(eventId)).data;
      return event.active == true
        && (!('closesAt' in event) || request.time < event.closesAt);
    }

    function canEditSeason(eventId) {
      return isEditor(eventAlliance(eventId)) && eventIsWritable(eventId);
    }

    function allianceMemberPath(allianceId, memberId) {
      return /databases/$(database)/documents/alliances/$(allianceId)/members/$(memberId);
    }

    function validEventSettings(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 100
        && (!('titleEn' in data) || (data.titleEn is string && data.titleEn.size() <= 100))
        && data.externalName is string && data.externalName.size() > 0 && data.externalName.size() <= 40
        && data.capacity is int && data.capacity > 0 && data.capacity <= 500
        && (!('closesAt' in data) || data.closesAt is timestamp)
        && data.active == true;
    }

    function validInviteSet(allianceId, data) {
      return data.keys().hasOnly(['xiaoxing', 'snoopy'])
        && data.keys().hasAll(['xiaoxing', 'snoopy'])
        && getAfter(/databases/$(database)/documents/allianceInvites/$(data.xiaoxing)).data.allianceId == allianceId
        && getAfter(/databases/$(database)/documents/allianceInvites/$(data.snoopy)).data.allianceId == allianceId;
    }

    function validAllianceMember(data) {
      return data.keys().hasOnly(['name', 'power', 'rank', 'version', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['name', 'power', 'rank', 'version', 'createdAt', 'updatedAt'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 100
        && data.name == data.name.trim()
        && (data.power == null || (data.power is int && data.power >= 0 && data.power <= 9007199254740991))
        && data.rank in ['r5', 'r4', 'member']
        && data.version is int
        && data.updatedAt == request.time;
    }

    match /allianceInvites/{inviteId} {
      allow get: if signedIn();
      // 編輯者換新連結：建立新邀請、停用舊邀請
      allow create: if inviteId.size() >= 24
        && request.resource.data.keys().hasOnly(['allianceId', 'role', 'active', 'createdAt'])
        && request.resource.data.allianceId is string
        && request.resource.data.role in roles()
        && request.resource.data.active == true
        && request.resource.data.createdAt == request.time
        && isEditor(request.resource.data.allianceId);
      allow update: if isEditor(resource.data.allianceId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active'])
        && request.resource.data.active == false;
    }

    match /alliances/{allianceId} {
      allow read: if true;
      allow write: if false;

      match /members/{memberId} {
        allow read: if true;
        allow create: if isEditor(allianceId)
          && validAllianceMember(request.resource.data)
          && request.resource.data.version == 1
          && request.resource.data.createdAt == request.time;
        allow update: if isEditor(allianceId)
          && validAllianceMember(request.resource.data)
          && request.resource.data.version == resource.data.version + 1
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isEditor(allianceId);
      }

      match /editors/{uid} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['allianceId', 'inviteId', 'role', 'joinedAt', 'lastSeenAt'])
          && request.resource.data.allianceId == allianceId
          && request.resource.data.role in roles()
          && validInvite(allianceId, request.resource.data.role, request.resource.data.inviteId)
          && request.resource.data.joinedAt == request.time
          && request.resource.data.lastSeenAt == request.time;
      }

      match /admin/{documentId} {
        allow read: if isEditor(allianceId);
        allow create, update: if documentId == 'invites'
          && isEditor(allianceId)
          && validInviteSet(allianceId, request.resource.data);
      }
    }

    match /transferEvents/{eventId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'title', 'titleEn', 'externalName', 'capacity', 'closesAt', 'active', 'allianceId', 'createdAt'
        ])
        && validEventSettings(request.resource.data)
        && request.resource.data.allianceId is string
        && exists(/databases/$(database)/documents/alliances/$(request.resource.data.allianceId))
        && request.resource.data.createdAt == request.time;
      // 已結束的賽季也可改結束時間（延長）
      allow update: if isEditor(eventAlliance(eventId))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'titleEn', 'externalName', 'closesAt'
        ])
        && validEventSettings(request.resource.data);
      allow delete: if isEditor(eventAlliance(eventId));

      function validRecordState(data) {
        return data.kick is bool
          && data.backup is bool
          && data.removed is bool
          && data.transferred is bool
          && data.note is string
          && data.note.size() <= 500
          && data.updatedAt == request.time
          && data.updatedBy == editorRole(eventAlliance(eventId));
      }

      match /members/{memberId} {
        allow read: if true;
        // 單筆刪除外部轉入者，或刪除整個賽季時逐筆清除（已結束的賽季也要能刪）
        allow delete: if isEditor(eventAlliance(eventId));

        allow create: if canEditSeason(eventId)
          && validRecordState(request.resource.data)
          && (
            (
              // 聯盟成員第一次被操作時才建立賽季紀錄：只含私人狀態，且主檔必須存在
              request.resource.data.keys().hasOnly([
                'list', 'kick', 'backup', 'removed', 'transferred', 'note', 'updatedAt', 'updatedBy'
              ])
              && request.resource.data.list == 'koi'
              && exists(allianceMemberPath(eventAlliance(eventId), memberId))
            )
            || (
              // 外部轉入名單新增玩家
              request.resource.data.keys().hasOnly([
                'list', 'number', 'name', 'kick', 'backup', 'removed', 'transferred', 'note', 'updatedAt', 'updatedBy'
              ])
              && request.resource.data.list == 'bdk'
              && request.resource.data.number is int
              && request.resource.data.number > 0
              && request.resource.data.name is string
              && request.resource.data.name.size() > 0
              && request.resource.data.name.size() <= 100
              && request.resource.data.name == request.resource.data.name.trim()
              && request.resource.data.kick == false
              && request.resource.data.backup == false
              && request.resource.data.removed == false
            )
          );

        allow update: if canEditSeason(eventId)
          && (
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'kick', 'backup', 'removed', 'transferred', 'note', 'updatedAt', 'updatedBy'
              ])
              && validRecordState(request.resource.data)
            )
            || (
              // 轉入者建立聯盟主檔：只能在同一批寫入中新建固定 ID 的主檔，且只能關聯一次
              resource.data.list == 'bdk'
              && !('allianceMemberId' in resource.data)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'allianceMemberId', 'updatedAt', 'updatedBy'
              ])
              && request.resource.data.allianceMemberId == eventId + '--' + memberId
              && !exists(allianceMemberPath(eventAlliance(eventId), request.resource.data.allianceMemberId))
              && existsAfter(allianceMemberPath(eventAlliance(eventId), request.resource.data.allianceMemberId))
              && request.resource.data.updatedAt == request.time
              && request.resource.data.updatedBy == editorRole(eventAlliance(eventId))
            )
          );
      }
    }
  }
}
