rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function participant(eventId) {
      return get(/databases/$(database)/documents/transferEvents/$(eventId)/participants/$(request.auth.uid));
    }

    function invitation(inviteId) {
      return get(/databases/$(database)/documents/transferInvites/$(inviteId));
    }

    function validInvite(eventId, role, inviteId) {
      let invite = invitation(inviteId);
      return invite.data.active == true
        && invite.data.eventId == eventId
        && invite.data.role == role
        && (!('expiresAt' in invite.data) || request.time < invite.data.expiresAt);
    }

    function hasAccess(eventId) {
      let access = participant(eventId);
      return signedIn()
        && access.data.eventId == eventId
        && validInvite(eventId, access.data.role, access.data.inviteId);
    }

    function eventIsOpen(eventId) {
      return get(/databases/$(database)/documents/transferEvents/$(eventId)).data.active == true;
    }

    // 可寫入：活動開啟且未超過結束時間（closesAt 選填）；過了結束時間仍可讀取，只是變唯讀
    function eventIsWritable(eventId) {
      let event = get(/databases/$(database)/documents/transferEvents/$(eventId)).data;
      return event.active == true
        && (!('closesAt' in event) || request.time < event.closesAt);
    }

    function isAdmin(eventId) {
      return hasAccess(eventId) && participant(eventId).data.role == 'adm';
    }

    function eventAlliance(eventId) {
      let event = get(/databases/$(database)/documents/transferEvents/$(eventId)).data;
      return 'allianceId' in event ? event.allianceId : 'koi';
    }

    function allianceMemberPath(allianceId, memberId) {
      return /databases/$(database)/documents/alliances/$(allianceId)/members/$(memberId);
    }

    // 聯盟主檔只能由「聯盟設定指定的賽季」中、持有效邀請的 Adm／R5 維護
    function canMaintainAlliance(allianceId) {
      let eventId = get(/databases/$(database)/documents/alliances/$(allianceId)).data.maintainerEventId;
      return eventId is string
        && hasAccess(eventId)
        && eventIsWritable(eventId)
        && eventAlliance(eventId) == allianceId
        && participant(eventId).data.role in ['adm', 'r5'];
    }

    // 聯盟管理者：聯盟維護賽季中持有效 Adm 邀請者（賽季結束後仍可建立下一季）
    function isAllianceAdmin(allianceId) {
      let eventId = get(/databases/$(database)/documents/alliances/$(allianceId)).data.maintainerEventId;
      return eventId is string
        && hasAccess(eventId)
        && eventAlliance(eventId) == allianceId
        && participant(eventId).data.role == 'adm';
    }

    // 可清除的歷史賽季：同聯盟的管理者，且不是目前的維護賽季（避免刪掉自己正在用的賽季）
    function canDeleteSeason(eventId) {
      let allianceId = eventAlliance(eventId);
      return isAllianceAdmin(allianceId)
        && get(/databases/$(database)/documents/alliances/$(allianceId)).data.maintainerEventId != eventId;
    }

    function eventPath(eventId) {
      return /databases/$(database)/documents/transferEvents/$(eventId);
    }

    // 同一批寫入中新建的賽季：寫入前不存在、寫入後存在，且聯盟維護權限同時移到它
    function isNewSeason(eventId) {
      let after = getAfter(eventPath(eventId)).data;
      return !exists(eventPath(eventId))
        && existsAfter(eventPath(eventId))
        && isAllianceAdmin(after.allianceId)
        && getAfter(/databases/$(database)/documents/alliances/$(after.allianceId)).data.maintainerEventId == eventId;
    }

    function validEventSettings(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 100
        && (!('titleEn' in data) || (data.titleEn is string && data.titleEn.size() <= 100))
        && data.externalName is string && data.externalName.size() > 0 && data.externalName.size() <= 40
        && data.capacity is int && data.capacity > 0 && data.capacity <= 500
        && (!('closesAt' in data) || data.closesAt is timestamp)
        && data.active == true;
    }

    function validInviteSet(eventId, data) {
      return data.keys().hasOnly(['r5', 'r4', 'adm'])
        && data.keys().hasAll(['r5', 'r4', 'adm'])
        && getAfter(/databases/$(database)/documents/transferInvites/$(data.r5)).data.eventId == eventId
        && getAfter(/databases/$(database)/documents/transferInvites/$(data.r4)).data.eventId == eventId
        && getAfter(/databases/$(database)/documents/transferInvites/$(data.adm)).data.eventId == eventId;
    }

    function validAllianceMember(data) {
      return data.keys().hasOnly(['name', 'power', 'rank', 'version', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['name', 'power', 'rank', 'version', 'createdAt', 'updatedAt'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 100
        && data.name == data.name.trim()
        && (data.power == null || (data.power is int && data.power >= 0 && data.power <= 9007199254740991))
        && data.rank in ['r5', 'r4', 'member']
        && data.version is int
        && data.updatedAt == request.time;
    }

    match /alliances/{allianceId} {
      allow read: if true;
      allow create, delete: if false;
      // 建立新賽季時一併移交維護權限；只能指向同一批寫入中新建、屬於本聯盟的賽季
      allow update: if isAllianceAdmin(allianceId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['maintainerEventId'])
        && request.resource.data.maintainerEventId is string
        && !exists(eventPath(request.resource.data.maintainerEventId))
        && getAfter(eventPath(request.resource.data.maintainerEventId)).data.allianceId == allianceId;

      match /members/{memberId} {
        allow read: if true;
        allow create: if canMaintainAlliance(allianceId)
          && validAllianceMember(request.resource.data)
          && request.resource.data.version == 1
          && request.resource.data.createdAt == request.time;
        allow update: if canMaintainAlliance(allianceId)
          && validAllianceMember(request.resource.data)
          && request.resource.data.version == resource.data.version + 1
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if canMaintainAlliance(allianceId);
      }
    }

    match /transferInvites/{inviteId} {
      allow get: if signedIn();
      // 刪除歷史賽季時，用 where('eventId', '==', X) 找出並刪掉它所有的邀請（含已停用的）
      allow list, delete: if canDeleteSeason(resource.data.eventId);
      // Adm 重新產生連結，或建立新賽季時一併產生
      allow create: if inviteId.size() >= 24
        && request.resource.data.keys().hasOnly(['eventId', 'role', 'active', 'createdAt'])
        && request.resource.data.eventId is string
        && request.resource.data.role in ['r5', 'r4', 'adm']
        && request.resource.data.active == true
        && request.resource.data.createdAt == request.time
        && (isAdmin(request.resource.data.eventId) || isNewSeason(request.resource.data.eventId));
      // 只能停用，不能改指向
      allow update: if isAdmin(resource.data.eventId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active'])
        && request.resource.data.active == false;
    }

    match /transferEvents/{eventId} {
      allow get: if hasAccess(eventId);
      // 管理者以 where('allianceId', '==', X) 列出同聯盟的所有賽季
      allow list: if isAllianceAdmin(resource.data.allianceId);
      allow delete: if canDeleteSeason(eventId);
      allow create: if request.resource.data.keys().hasOnly([
          'title', 'titleEn', 'externalName', 'capacity', 'closesAt', 'active', 'allianceId', 'createdAt'
        ])
        && validEventSettings(request.resource.data)
        && request.resource.data.allianceId is string
        && request.resource.data.createdAt == request.time
        && isNewSeason(eventId);
      // Adm 調整賽季設定；已結束的賽季也可改結束時間（延長）
      allow update: if isAdmin(eventId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'titleEn', 'externalName', 'closesAt'
        ])
        && validEventSettings(request.resource.data);

      match /participants/{uid} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow list, delete: if canDeleteSeason(eventId);
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly([
            'eventId', 'inviteId', 'role', 'joinedAt', 'lastSeenAt'
          ])
          && request.resource.data.eventId == eventId
          && request.resource.data.role in ['r5', 'r4', 'adm']
          && validInvite(
            eventId,
            request.resource.data.role,
            request.resource.data.inviteId
          )
          && request.resource.data.joinedAt == request.time
          && request.resource.data.lastSeenAt == request.time;
      }

      function validRecordState(data) {
        return data.kick is bool
          && data.backup is bool
          && data.removed is bool
          && data.transferred is bool
          && data.note is string
          && data.note.size() <= 500
          && data.updatedAt == request.time
          && data.updatedBy == participant(eventId).data.role;
      }

      match /members/{memberId} {
        allow read: if hasAccess(eventId) && eventIsOpen(eventId);
        allow list: if canDeleteSeason(eventId);
        // 外部轉入名單可由 Adm／R5 刪除；已建立聯盟主檔關聯者保留，避免關聯斷掉。
        // 刪除整個歷史賽季時，管理者可刪除全部紀錄（聯盟主檔不受影響）
        allow delete: if canDeleteSeason(eventId) || hasAccess(eventId)
          && eventIsWritable(eventId)
          && participant(eventId).data.role in ['adm', 'r5']
          && resource.data.list == 'bdk'
          && !('allianceMemberId' in resource.data);

        allow create: if hasAccess(eventId)
          && eventIsWritable(eventId)
          && validRecordState(request.resource.data)
          && (
            (
              // 聯盟新成員第一次被操作時才建立賽季紀錄：只含私人狀態，且主檔必須存在
              request.resource.data.keys().hasOnly([
                'list', 'kick', 'backup', 'removed', 'transferred', 'note', 'updatedAt', 'updatedBy'
              ])
              && request.resource.data.list == 'koi'
              && exists(allianceMemberPath(eventAlliance(eventId), memberId))
            )
            || (
              // Adm／R5 在外部轉入名單新增玩家
              participant(eventId).data.role in ['adm', 'r5']
              && request.resource.data.keys().hasOnly([
                'list', 'number', 'name', 'kick', 'backup', 'removed', 'transferred', 'note', 'updatedAt', 'updatedBy'
              ])
              && request.resource.data.list == 'bdk'
              && request.resource.data.number is int
              && request.resource.data.number > 0
              && request.resource.data.name is string
              && request.resource.data.name.size() > 0
              && request.resource.data.name.size() <= 100
              && request.resource.data.name == request.resource.data.name.trim()
              && request.resource.data.kick == false
              && request.resource.data.backup == false
              && request.resource.data.removed == false
            )
          );

        allow update: if hasAccess(eventId)
          && eventIsWritable(eventId)
          && (
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'kick', 'backup', 'removed', 'transferred', 'note', 'updatedAt', 'updatedBy'
              ])
              && validRecordState(request.resource.data)
            )
            || (
              // 轉入者建立聯盟主檔：只能在同一批寫入中新建固定 ID 的主檔，且只能關聯一次
              resource.data.list == 'bdk'
              && !('allianceMemberId' in resource.data)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'allianceMemberId', 'updatedAt', 'updatedBy'
              ])
              && request.resource.data.allianceMemberId == eventId + '--' + memberId
              && participant(eventId).data.role in ['adm', 'r5']
              && !exists(allianceMemberPath(eventAlliance(eventId), request.resource.data.allianceMemberId))
              && existsAfter(allianceMemberPath(eventAlliance(eventId), request.resource.data.allianceMemberId))
              && request.resource.data.updatedAt == request.time
              && request.resource.data.updatedBy == participant(eventId).data.role
            )
          );
      }

      match /admin/{documentId} {
        allow read: if isAdmin(eventId) && eventIsOpen(eventId);
        allow list, delete: if canDeleteSeason(eventId);
        allow create: if documentId == 'invites'
          && isNewSeason(eventId)
          && validInviteSet(eventId, request.resource.data);
        allow update: if documentId == 'invites'
          && isAdmin(eventId)
          && validInviteSet(eventId, request.resource.data);
      }
    }
  }
}
