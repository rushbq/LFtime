rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function participant(eventId) {
      return get(/databases/$(database)/documents/transferEvents/$(eventId)/participants/$(request.auth.uid));
    }

    function invitation(inviteId) {
      return get(/databases/$(database)/documents/transferInvites/$(inviteId));
    }

    function validInvite(eventId, role, inviteId) {
      let invite = invitation(inviteId);
      return invite.data.active == true
        && invite.data.eventId == eventId
        && invite.data.role == role
        && (!('expiresAt' in invite.data) || request.time < invite.data.expiresAt);
    }

    function hasAccess(eventId) {
      let access = participant(eventId);
      return signedIn()
        && access.data.eventId == eventId
        && validInvite(eventId, access.data.role, access.data.inviteId);
    }

    function eventIsOpen(eventId) {
      return get(/databases/$(database)/documents/transferEvents/$(eventId)).data.active == true;
    }

    function isAdmin(eventId) {
      return hasAccess(eventId) && participant(eventId).data.role == 'adm';
    }

    function eventAlliance(eventId) {
      let event = get(/databases/$(database)/documents/transferEvents/$(eventId)).data;
      return 'allianceId' in event ? event.allianceId : 'koi';
    }

    function allianceMemberPath(allianceId, memberId) {
      return /databases/$(database)/documents/alliances/$(allianceId)/members/$(memberId);
    }

    // 聯盟主檔只能由「聯盟設定指定的賽季」中、持有效邀請的 Adm／R5 維護
    function canMaintainAlliance(allianceId) {
      let eventId = get(/databases/$(database)/documents/alliances/$(allianceId)).data.maintainerEventId;
      return eventId is string
        && hasAccess(eventId)
        && eventIsOpen(eventId)
        && eventAlliance(eventId) == allianceId
        && participant(eventId).data.role in ['adm', 'r5'];
    }

    function validAllianceMember(data) {
      return data.keys().hasOnly(['name', 'power', 'rank', 'version', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['name', 'power', 'rank', 'version', 'createdAt', 'updatedAt'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 100
        && data.name == data.name.trim()
        && (data.power == null || (data.power is int && data.power >= 0 && data.power <= 9007199254740991))
        && data.rank in ['r5', 'r4', 'member']
        && data.version is int
        && data.updatedAt == request.time;
    }

    match /alliances/{allianceId} {
      allow read: if true;
      allow write: if false;

      match /members/{memberId} {
        allow read: if true;
        allow create: if canMaintainAlliance(allianceId)
          && validAllianceMember(request.resource.data)
          && request.resource.data.version == 1
          && request.resource.data.createdAt == request.time;
        allow update: if canMaintainAlliance(allianceId)
          && validAllianceMember(request.resource.data)
          && request.resource.data.version == resource.data.version + 1
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if canMaintainAlliance(allianceId);
      }
    }

    match /transferInvites/{inviteId} {
      allow get: if signedIn();
      allow list, create, update, delete: if false;
    }

    match /transferEvents/{eventId} {
      allow get: if hasAccess(eventId);
      allow list, create, update, delete: if false;

      match /participants/{uid} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow list, delete: if false;
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly([
            'eventId', 'inviteId', 'role', 'joinedAt', 'lastSeenAt'
          ])
          && request.resource.data.eventId == eventId
          && request.resource.data.role in ['r5', 'r4', 'adm']
          && validInvite(
            eventId,
            request.resource.data.role,
            request.resource.data.inviteId
          )
          && request.resource.data.joinedAt == request.time
          && request.resource.data.lastSeenAt == request.time;
      }

      function validRecordState(data) {
        return data.kick is bool
          && data.backup is bool
          && data.removed is bool
          && data.transferred is bool
          && data.note is string
          && data.note.size() <= 500
          && data.updatedAt == request.time
          && data.updatedBy == participant(eventId).data.role;
      }

      match /members/{memberId} {
        allow read: if hasAccess(eventId) && eventIsOpen(eventId);
        allow delete: if false;

        // 聯盟新成員第一次被操作時才建立賽季紀錄：只含私人狀態，且主檔必須存在
        allow create: if hasAccess(eventId)
          && eventIsOpen(eventId)
          && request.resource.data.keys().hasOnly([
            'list', 'kick', 'backup', 'removed', 'transferred', 'note', 'updatedAt', 'updatedBy'
          ])
          && request.resource.data.list == 'koi'
          && exists(allianceMemberPath(eventAlliance(eventId), memberId))
          && validRecordState(request.resource.data);

        allow update: if hasAccess(eventId)
          && eventIsOpen(eventId)
          && (
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'kick', 'backup', 'removed', 'transferred', 'note', 'updatedAt', 'updatedBy'
              ])
              && validRecordState(request.resource.data)
            )
            || (
              // 轉入者建立聯盟主檔：只能在同一批寫入中新建固定 ID 的主檔，且只能關聯一次
              resource.data.list == 'bdk'
              && !('allianceMemberId' in resource.data)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'allianceMemberId', 'updatedAt', 'updatedBy'
              ])
              && request.resource.data.allianceMemberId == eventId + '--' + memberId
              && participant(eventId).data.role in ['adm', 'r5']
              && !exists(allianceMemberPath(eventAlliance(eventId), request.resource.data.allianceMemberId))
              && existsAfter(allianceMemberPath(eventAlliance(eventId), request.resource.data.allianceMemberId))
              && request.resource.data.updatedAt == request.time
              && request.resource.data.updatedBy == participant(eventId).data.role
            )
          );
      }

      match /admin/{documentId} {
        allow read: if isAdmin(eventId) && eventIsOpen(eventId);
        allow write: if false;
      }
    }
  }
}
